# App
ADMIN_TOKEN=dev-admin-token
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/finfluencer
POLLER_INTERVAL_SECONDS=300
WORKER_POLL_INTERVAL_SECONDS=3
RETRY_MAX_ATTEMPTS=5
RETRY_BACKOFF_BASE_SECONDS=1.5
WORKER_BATCH_SIZE=8

# External providers
YOUTUBE_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=mock  # mock|openai
OPENAI_MODEL=gpt-4o-mini

# LLM behavior/versioning
PROMPT_VERSION=v1.0
TAXONOMY_VERSION=v1.0

# STT
STT_ENABLED=true
STT_CHUNK_SECONDS=900
STT_MAX_VIDEO_MINUTES=90
STT_USE_MOCK_WHEN_MISSING=true
TRANSCRIPT_PROVIDER_PREFERRED=public_transcript

# Optional: durable sqlite backup on Cloud Run (no Cloud SQL)
ENABLE_SQLITE_PERSISTENCE=true
SQLITE_BACKUP_BUCKET=finfluencer-sqlite-backup
SQLITE_BACKUP_PREFIX=finfluencer-mvp
SQLITE_PERSISTENCE_INTERVAL_SECONDS=300
